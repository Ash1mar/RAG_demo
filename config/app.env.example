## Centralized app config (loaded at startup)
## Copy to config/app.env and edit for your environment.
## Environment variables override this file.

# ---- Vector store / embeddings ----
# STORE=faiss
MOCK_EMB=1
# EMB_URL=http://localhost:8080/embeddings
# EMB_TIMEOUT=12

# ---- Tasks backend + SQL dialect ----
TASKS_BACKEND=mssql
TASKS_DIALECT=mssql
TASKS_LATEST_RELATION=task_latest
TASKS_HISTORY_RELATION=tasks
TASKS_ALLOWED_RELATIONS=task_latest,tasks

# ---- SQL Server tasks backend ----
# Server format: host,port
TASKS_MSSQL_SERVER=127.0.0.1,1433
TASKS_MSSQL_DATABASE=fact_tasks
TASKS_MSSQL_USER=sa
TASKS_MSSQL_PASSWORD=your_password_here

# Intranet note: use the installed driver name on that machine (e.g. Driver 17).
TASKS_MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# Encrypt/trust settings depend on your SQL Server TLS setup.
# If you see certificate errors, set TRUST to yes (or set ENCRYPT=no per policy).
TASKS_MSSQL_ENCRYPT=yes
TASKS_MSSQL_TRUST_CERT=yes
TASKS_MSSQL_TIMEOUT_SEC=5

# ---- Task resolver ----
RESOLVER=text2sql
TASKS_NL2SQL_LLM=1

# ---- LLM / Text2SQL ----
LLM_ENABLED=true
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_TEXT2SQL_PROVIDER=ollama
LLM_TEXT2SQL_MODEL=qwen3-coder:480b-cloud
LLM_OLLAMA_BASE_URL=http://localhost:11434
