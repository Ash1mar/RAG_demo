## Centralized app config (loaded at startup)
## All values are optional; environment variables override this file.

# ---- Vector store / embeddings ----
# STORE=faiss
MOCK_EMB=1
# MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMB_DIM=384
# EMB_URL=http://localhost:8080/embeddings
# EMB_TIMEOUT=12
# DATA_DIR=data

# ---- Tasks backend + SQL dialect ----
# TASKS_BACKEND=sqlite        # sqlite | mssql
TASKS_BACKEND=mssql
# TASKS_DIALECT=sqlite        # sqlite | mssql
TASKS_DIALECT=mssql
# TASKS_DB=data/tasks.db
TASKS_LATEST_RELATION=task_latest
TASKS_HISTORY_RELATION=tasks
TASKS_ALLOWED_RELATIONS=task_latest,tasks

# Optional: map logical fields to physical columns (when no compatibility views)
# TASKS_COL_PERSON=person
# TASKS_COL_TASK=task
# TASKS_COL_STATUS=status
# TASKS_COL_TS=ts

# ---- SQL Server tasks backend ----
TASKS_MSSQL_SERVER=127.0.0.1,1433
TASKS_MSSQL_DATABASE=fact_tasks
TASKS_MSSQL_USER=sa
TASKS_MSSQL_PASSWORD=StrongPassword@2025
TASKS_MSSQL_DRIVER=ODBC Driver 18 for SQL Server
TASKS_MSSQL_ENCRYPT=yes
TASKS_MSSQL_TRUST_CERT=yes
TASKS_MSSQL_TIMEOUT_SEC=5

# ---- Task resolver ----
RESOLVER=text2sql
# rules | embeddings | hybrid | hybrid_plus_rules | hybrid_llm | text2sql
TASKS_NL2SQL_LLM=1

# ---- LLM / Text2SQL ----
LLM_ENABLED=true
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_TEXT2SQL_PROVIDER=ollama
LLM_TEXT2SQL_MODEL=qwen3-coder:480b-cloud
LLM_OLLAMA_BASE_URL=http://localhost:11434
# LLM_TEXT2SQL_OLLAMA_BASE_URL=
# LLM_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_TEXT2SQL_OPENAI_BASE_URL=
# LLM_API_KEY=
# LLM_TEXT2SQL_API_KEY=
